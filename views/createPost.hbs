<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Share - WEEBSITE</title>
    <link rel="stylesheet" href="styles/variables.css" />
    <link rel="stylesheet" href="styles/share.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <script src="scripts/views.js" defer></script>
    <script src="/scripts/data.js" defer></script>
    <script src="scripts/include.js" defer></script>
    <script src="/scripts/share.js" defer></script>
  </head>
  <body>
    <nav>
      <a onclick="switchPage('home')">
        <div class="logo">WEEBSITE</div>
      </a>
      </button>
    </nav>
    <div class="share-container">
      <!-- Sidebar -->
      <div class="sidebar">
        <h3> Quick Links</h3>
        <ul>
          <li>
            <button class="quickLinkText">
              <i class="fas fa-info-circle"></i>
               Sharing Guidelines
            </button>
          </li>
          <li>
            <button class="quickLinkText">
              <i class="fas fa-star"></i>
               Support Us
            </button>
          </li>
          <li>
            <button class="quickLinkText"><i class="fas fa-question-circle"></i>  FAQs</button>
          </li>
          <li>
            <button class="quickLinkText"><i class="fas fa-cog"></i>  Settings</button>
          </li>
        </ul>
      </div>

      <!-- Share Form -->
<form class="share-form" id="post-form" onsubmit="getPostData(event)" enctype="multipart/form-data">
    <div class="share-title">Share Your Content</div>
    <label for="title"><b>Title</b></label>
    <input
        type="text"
        id="title"
        name="title"
        placeholder="Enter a title for your post..."
        required
    />

    <div style="display: flex; flex-direction: row;">
        <textarea 
            style="width: 400px; height: 321px; margin-right: 20px;"
            id="content"
            name="content"
            placeholder="Describe your content..."
        ></textarea>
        <div id="drop-area">
            <label for="images">Upload an Image:</label>
            <input type="file" id="images" name="images" accept="image/*" multiple hidden>
            <img id="preview" src="#" alt="Image Preview" style="display:none;">
        </div>
    </div>

    <label for="community">Communities</label>
    <input
        type="text"
        id="community"
        name="community"
        placeholder="Add community (e.g., Naruto, One Piece, Bleach)..."
        required
    />

    <button type="submit"><i class="fas fa-share"></i> Share Now</button>
</form>
    </div>
    <footer>
      <p>
        © 2025 Weebsite.
        <a href="#">Privacy Policy</a>
        |
        <a href="#">Terms of Service</a>
      </p>
    </footer>
  </body>
</html>