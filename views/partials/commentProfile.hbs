<div class="comment-section">
  <div class="postHeader">
    <div class="postHeaderLeft commentUser">
      <img
        src="{{authorProfilePicture}}"
        class="pfp"
        alt="Profile Picture"
        onerror="this.onerror=null; this.src='/images/anonymous.png'"
      />
      <span class="postUsername">u/{{author}}</span>
      <span class="postTime"> 12 hours ago</span>
    </div>
    <!-- Right Side: Kebab Menu Icon -->
    <div class="postHeaderRight" style="flex-direction: column;">
    </div>
  </div>
  <div class="commentSectionText" id="commentSectionText-{{_id}}">
    <p class="commentBody">{{content}}</p>
  </div>
  {{! editing field thats hidden lol }}
  <div class="postActions">
    <div class="reactionsContainer">
      <!-- Thumbs Up Box -->
      <div class="reactionBox">
        <button
          class="actionButton like-button"
          aria-label="Thumbs Up"
          data-author="{{author}}"
          data-comment-id="{{_id}}"
          data-liked="false"
          onclick="upvoteComment('{{_id}}')"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path
              d="M1 21h4V9H1v12z M23 10c0-1.1-0.9-2-2-2h-6.31l0.95-4.57a1.983 1.983 0 0 0-0.44-1.74L14.17 1l-6.58 6.59A2 2 0 0 0 7 9v10a2 2 0 0 0 2 2h9c0.83 0 1.54-0.5 1.84-1.22l3.02-7.05c0.09-0.23 0.14-0.47 0.14-0.73v-2z"
            />
          </svg>
        </button>
        <span class="voteCount" id="upvotes-{{_id}}">{{upvotes}}</span>
      </div>
      <!-- Thumbs Down Box -->
      <div class="reactionBox">
        <button
          class="actionButton dislike-button"
          aria-label="Thumbs Down"
          data-author="{{author}}"
          data-comment-id="{{_id}}"
          data-disliked="false"
          onclick="downvoteComment('{{_id}}')"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path
              d="M23 3h-4v12h4V3z M1 14c0 1.1 0.9 2 2 2h6.31l-0.95 4.57a1.983 1.983 0 0 0 0.44 1.74L9.83 23l6.58-6.59c0.36-0.36 0.58-0.86 0.58-1.41V5a2 2 0 0 0-2-2H5c-0.83 0-1.54 0.5-1.84 1.22L0.14 11.27c-0.09 0.23-0.14 0.47-0.14 0.73v2z"
            />
          </svg>
        </button>
        <span class="voteCount" id="downvotes-{{_id}}">{{downvotes}}</span>
      </div>

      <!-- Comment Box -->
      <div class="reactionBox">
        <button
          class="actionButton"
          aria-label="Comment"
          onclick="toggleNestedComment('{{_id}}')"
          data-page="nested-comments"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            fill="currentColor"
            class="size-4"
          >
            <path
              fill-rule="evenodd"
              d="M8 2C4.262 2 1 4.57 1 8c0 1.86.98 3.486 2.455 4.566a3.472 3.472 0 0 1-.469 1.26.75.75 0 0 0 .713 1.14 6.961 6.961 0 0 0 3.06-1.06c.403.062.818.094 1.241.094 3.738 0 7-2.57 7-6s-3.262-6-7-6ZM5 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm7-1a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM8 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>

    </div>
  </div>
</div>