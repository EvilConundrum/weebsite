<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{profileData.username}}'s Profile</title>
    <link rel="stylesheet" href="/styles/profile.css" />
    <link rel="stylesheet" href="/styles/indexstyles.css" />
    <link rel="stylesheet" href="/styles/variables.css" />
    <link rel="stylesheet" href="/styles/post.css" />
    <link rel="stylesheet" href="/styles/layout.css" />
    <script src="/scripts/include.js" defer></script>
    <script src="/scripts/button.js" defer></script>
    <script src="/scripts/views.js" defer></script>
  </head>
  <body>
    {{> layout userData=userData}}

    <div id="page-content">
      <div id="main-content">
        <div id="bio-header">u/{{profileData.username}}</div>
        <div id="bio">
         <img id="bio-image" 
          src="{{#if profileData.profilePicture}}{{profileData.profilePicture}}{{else}}/images/anonymous.png{{/if}}" 
          alt="{{#if profileData.profilePicture}}Profile Picture{{else}}Default Profile Picture{{/if}}"
          onerror="this.onerror=null; this.src='/images/anonymous.png'">
          <div id="bio-content">
            <p>
              {{profileData.bio}}
            </p>
            {{#if isOwnProfile}}
            <div class="button-bar">
              <button
                id="edit-profile-button"
                onclick="window.open('/edit-profile', '_self')"
              >
                Edit Profile
              </button>
            </div>
            {{/if}}
          </div>
        </div>
        <div id="filter-menu">
          <div class="filter-button {{#if isPostsTab}}active{{/if}}" 
               data-page="posts" 
               onclick="switchProfileTab('{{profileData.username}}', 'posts')">
            <p>Posts</p>
          </div>
          <div class="filter-button {{#if isSharedPostsTab}}active{{/if}}" 
               data-page="shared-posts" 
               onclick="switchProfileTab('{{profileData.username}}', 'shared-posts')">
            <p>Shared Posts</p>
          </div>
          <div class="filter-button {{#if isUpvotesTab}}active{{/if}}" 
               data-page="upvotes" 
               onclick="switchProfileTab('{{profileData.username}}', 'upvotes')">
            <p>Upvoted</p>
          </div>
          <div class="filter-button {{#if isDownvotesTab}}active{{/if}}" 
               data-page="downvotes" 
               onclick="switchProfileTab('{{profileData.username}}', 'downvotes')">
            <p>Downvoted</p>
          </div>
        </div>
        <div id="filter-results">
          {{#if isPostsTab}}
            {{#each posts}}
              {{> posts}}
            {{/each}}
          {{/if}}

          {{#if isSharedPostsTab}}
            {{#each sharedPosts}}
              {{> posts}}
            {{/each}}
          {{/if}}

          {{#if isUpvotesTab}}
            {{#each upvotedPosts}}
              {{> posts}}
            {{/each}}
          {{/if}}

          {{#if isDownvotesTab}}
            {{#each downvotedPosts}}
              {{> posts}}
            {{/each}}
          {{/if}}
        </div>
      </div>
    </div>

  {{!-- <script>
